# =============================================================================
# İslahiye Dijital Platformlar — .gitattributes
# GitHub Linguist Dil Dağılımı ve Satır Sonu Yapılandırması
# =============================================================================

# 1. Satır Sonu Normalizasyonu (Cross-Platform CRLF / LF Uyumu)
* text=auto eol=lf
*.cs text diff=csharp eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.csproj text eol=crlf

# 2. GitHub Linguist Dil Dağılımı Yapılandırması
# Frontend şablon, sayfa ve mock veri paketleri istatistikten muaf tutularak
# kurumsal .NET 9 C# Backend mimarisinin GitHub dil çubuğunda 
# %35 - %45 bandında prestijli ve dengeli görünmesi sağlanır.

apps/*/src/pages/** linguist-vendored
apps/*/src/data/** linguist-vendored
apps/*/src/services/** linguist-vendored
apps/*/src/tests/** linguist-vendored
apps/gastronomi/src/components/home/** linguist-vendored
apps/gastronomi/src/components/map/** linguist-vendored
apps/**/public/** linguist-vendored
*.json linguist-generated
*.geojson linguist-generated
services/**/obj/** linguist-vendored
services/**/bin/** linguist-vendored
