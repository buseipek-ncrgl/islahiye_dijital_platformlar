# ASP.NET Core Gastronomi API URL (Yerel geliştirme: http://localhost:5235)
# Prodüksiyonda güvenli HTTPS protokolü kullanılmalıdır (örn: https://api.islahiye.bel.tr)
VITE_GASTRONOMY_API_URL=http://localhost:5235

# İslahiye Eğitim ve Kursiyer Portalı Bağlantısı (Bağımsız React Uygulaması)
VITE_EGITIM_URL=http://localhost:5174

