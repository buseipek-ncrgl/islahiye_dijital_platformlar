{
  "name": "islahiye-dijital-platformlar",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:gastronomi": "npm run dev --workspace=apps/gastronomi",
    "dev:egitim": "npm run dev --workspace=apps/egitim",
    "dev:api": "dotnet run --project services/education-api/src/Education.Api",
    "build:gastronomi": "npm run build --workspace=apps/gastronomi",
    "build:egitim": "npm run build --workspace=apps/egitim",
    "test:e2e:b01": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-b01-e2e.ps1",
    "build": "npm run build --workspaces --if-present"
  },
  "keywords": [
    "islahiye",
    "gastronomi",
    "egitim",
    "monorepo"
  ],
  "author": "İslahiye Ticaret Odası",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
